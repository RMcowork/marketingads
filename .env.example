# Copy this file to .env and fill it in:   cp .env.example .env
# .env is ignored by git. Never commit it, never paste it into a chat.
# In the cloud (Railway, DigitalOcean) there is no .env: add the same names and values as service variables.

# ─── Required ──────────────────────────────────────────────────────────────────
# The password for the web page and the API (any user name). Use a long random one: anyone who has
# the URL and the password can spend your API credit.
APP_PASSWORD=
# Step-by-step instructions for every key: README.md → "Get your API keys".
#
# Anthropic: https://platform.claude.com/settings/keys → Create key. SELECT A WORKSPACE for the key.
# Add credit at https://platform.claude.com/settings/billing. Starts with sk-ant-
ANTHROPIC_API_KEY=
# Pictures: openai (needs OPENAI_API_KEY) or gemini (needs GEMINI_API_KEY)
IMAGE_PROVIDER=openai
# OpenAI: https://platform.openai.com/api-keys. Add credit at https://platform.openai.com/account/billing/overview,
# and verify the organization at https://platform.openai.com/settings/organization/general. Starts with sk-
OPENAI_API_KEY=
# Google: https://aistudio.google.com/api-keys. The image models need billing ("Set up billing", $5 minimum prepay).
# Starts with AIza
GEMINI_API_KEY=

# ─── The agent ─────────────────────────────────────────────────────────────────
# Leave empty when claude-lock.json is committed: the IDs are read from it. Otherwise paste what
# `npm run agents:ids` prints.
AD_AGENT_ID=
AD_ENVIRONMENT_ID=

# ─── Cost control (defaults shown) ─────────────────────────────────────────────
# Hard spending cap per agent session at list prices, in cents (300 = $3)
AD_SESSION_BUDGET_CENTS=300
# Agent runs (new ads + revisions) allowed in 24 hours, and at the same time
MAX_RUNS_PER_DAY=30
MAX_PARALLEL_RUNS=2
# Briefs the checks may send back in one run before the agent must stop and explain (the course rule: 3)
MAX_REJECTIONS=3

# The logo and the headline are put on every picture (src/overlay.mjs). Set to off to keep pictures as drawn.
AD_OVERLAY=on
# The headline font. Empty or "auto": each ad gets one of three or more modern fonts for its language.
# Or force one for every ad: Hebrew heebo | rubik | secular, English poppins | anton | rubik, Arabic tajawal | almarai | rubik
AD_FONT=

# ─── Telegram (optional) ───────────────────────────────────────────────────────
# Lets the owner make ads by chatting with a bot. Create the bot with @BotFather and paste its token here.
# Run only ONE copy of the service per bot (a laptop and Railway at once will fight over it).
TELEGRAM_BOT_TOKEN=
# Who may use the bot: chat ids separated by commas. Leave empty at first, start the service, send /myid to the
# bot, and it answers with your chat id. Anyone not on this list can only ask for their own id.
TELEGRAM_ALLOWED_CHAT_IDS=

# ─── The second-model review (src/review.mjs) ──────────────────────────────────
# A different model checks every accepted brief for language and brand before a picture is drawn. "off" skips it.
AD_REVIEW=on
# Leave empty when claude-lock.json is committed (`npm run agents:ids` prints it).
AD_REVIEWER_AGENT_ID=
# Times the writer may be sent back to fix what the reviewer found, before the draft is held back
AD_REVIEW_MAX_FIXES=2
# Hard spending cap per review session in cents, and seconds before a review is given up on
AD_REVIEW_BUDGET_CENTS=50
AD_REVIEW_TIMEOUT_SECONDS=120
# What happens when the reviewer is down: "open" lets the ad through marked not reviewed, "closed" holds the draft back
AD_REVIEW_FAIL=open

# ─── Security (SECURITY-ASSESSMENT.md) ─────────────────────────────────────────
# APP_PASSWORD must be 12+ characters in production: openssl rand -base64 24
# Behind a proxy (Railway, App Platform, Caddy): on. It is on by default when NODE_ENV=production. Leave it off when the
# service is reachable directly, because X-Forwarded-For would then be controlled by the caller.
AD_TRUST_PROXY=
# Wrong passwords allowed per client in the window, then a lockout (minutes)
AUTH_MAX_FAILURES=8
AUTH_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15

# ─── Optional ──────────────────────────────────────────────────────────────────
# Defaults: gpt-image-2.6-sunburst (openai) or gemini-nano-banana-2.1 (gemini), quality medium
IMAGE_MODEL=
IMAGE_QUALITY=medium
# The time zone used for "today" in the facts block
TIMEZONE=Asia/Jerusalem
# Seconds before a stuck agent run is interrupted
AD_TURN_TIMEOUT_SECONDS=420
